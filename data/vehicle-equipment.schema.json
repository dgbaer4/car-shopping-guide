{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "market",
    "catalogSha256",
    "sources",
    "trims",
    "relationships"
  ],
  "properties": {
    "schemaVersion": {
      "const": "vehicle-equipment/1.0"
    },
    "market": {
      "const": "US"
    },
    "catalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "trims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trim"
      }
    },
    "relationships": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "US retail trim equipment sidecar for v0.3",
  "$defs": {
    "status": {
      "enum": [
        "standard",
        "optional",
        "package-dependent",
        "unavailable",
        "unknown"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "locator",
            "evidence",
            "trimId"
          ],
          "properties": {
            "value": {
              "enum": [
                "Sedan",
                "Hatchback",
                "Wagon",
                "Compact crossover",
                "Midsize SUV",
                "Full-size SUV",
                "Pickup"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "trimId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "seats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "locator",
            "evidence",
            "trimId"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "trimId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "locator",
            "evidence",
            "trimId"
          ],
          "properties": {
            "value": {
              "enum": [
                "Gasoline",
                "Traditional hybrid",
                "Plug-in hybrid",
                "Fully electric"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "trimId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "drivetrain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "locator",
            "evidence",
            "trimId"
          ],
          "properties": {
            "value": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Front-Wheel Drive",
                  "Rear-Wheel Drive",
                  "All-Wheel Drive",
                  "4-Wheel Drive"
                ]
              }
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "trimId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "Heated front seats": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Ventilated front seats": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Power driver seat": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Heated steering wheel": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Keyless entry": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Push-button start": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Sunroof": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Leather seating": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Power liftgate": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Dual-zone climate control": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Apple CarPlay": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Wireless Apple CarPlay": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Android Auto": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Wireless Android Auto": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Wireless phone charging": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Built-in navigation": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Premium audio": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Backup camera": {
          "$ref": "#/$defs/equipmentFact"
        },
        "360-degree camera": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Blind-spot monitoring": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Rear cross-traffic alert": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Adaptive cruise control": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Automatic emergency braking": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Lane-keeping assistance": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Parking sensors": {
          "$ref": "#/$defs/equipmentFact"
        },
        "All-wheel drive": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Physical climate controls": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Touchscreen climate controls": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Spare tire": {
          "$ref": "#/$defs/equipmentFact"
        },
        "Remote start": {
          "$ref": "#/$defs/equipmentFact"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "year",
        "make",
        "model",
        "url",
        "accessed",
        "usage"
      ],
      "properties": {
        "market": {
          "const": "US"
        },
        "year": {
          "type": "integer",
          "minimum": 2021,
          "maximum": 2026
        },
        "make": {
          "enum": [
            "Toyota",
            "Honda",
            "Nissan",
            "Hyundai",
            "Kia"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "usage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "year",
        "make",
        "model",
        "id",
        "trim",
        "facts"
      ],
      "properties": {
        "market": {
          "const": "US"
        },
        "year": {
          "type": "integer",
          "minimum": 2021,
          "maximum": 2026
        },
        "make": {
          "enum": [
            "Toyota",
            "Honda",
            "Nissan",
            "Hyundai",
            "Kia"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trim": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "$ref": "#/$defs/facts"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epaId",
        "trimId",
        "status",
        "epaIdentity",
        "source",
        "locator",
        "evidence"
      ],
      "properties": {
        "epaId": {
          "type": "string",
          "pattern": "^epa-[0-9]+$"
        },
        "trimId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "supported-member"
        },
        "epaIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "drivetrain",
            "power"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "drivetrain": {
              "enum": [
                "Front-Wheel Drive",
                "Rear-Wheel Drive",
                "All-Wheel Drive",
                "4-Wheel Drive"
              ]
            },
            "power": {
              "enum": [
                "Gasoline",
                "Traditional hybrid",
                "Plug-in hybrid",
                "Fully electric"
              ]
            }
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "corroboration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "accessed",
            "locator"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "accessed": {
              "type": "string",
              "format": "date"
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "equipmentFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "locator",
        "evidence",
        "trimId"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "trimId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
